# Maintainer: GPUIdium maintainers <https://github.com/rpietzsch/gpuidium>
pkgname=gpuidium
pkgver=0.4.2
pkgrel=1
pkgdesc='A minimal workspace for arbitrary websites, each with its own isolated profile'
arch=('x86_64' 'aarch64')
url='https://github.com/rpietzsch/gpuidium'
license=('Apache-2.0')
# The page engine is the system WebKitGTK, so Arch's own security updates apply.
depends=('webkit2gtk-4.1' 'gtk3' 'libxkbcommon-x11' 'vulkan-icd-loader' 'xdg-utils')
makedepends=('cargo' 'pkgconf')
# makepkg's default LTO flags make the C shims of the Wayland crates unreadable for rust-lld
# ("undefined symbol: wl_log_trampoline_to_rust_client"); Rust packages on Arch disable it.
options=('!lto')
optdepends=('libnotify: fallback for desktop notifications'
            'vulkan-driver: GPU rendering (any Vulkan driver)')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Fill in after the release is tagged: `updpkgsums`.
sha256sums=('SKIP')

# CI / local testing: build from a tarball you made yourself instead of the GitHub tag.
#   GPUIDIUM_SRC=/abs/path/gpuidium-$pkgver.tar.gz makepkg -f
if [ -n "${GPUIDIUM_SRC:-}" ]; then
  source=("$pkgname-$pkgver.tar.gz::file://$GPUIDIUM_SRC")
fi

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN="${RUSTUP_TOOLCHAIN:-stable}"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN="${RUSTUP_TOOLCHAIN:-stable}"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p gpuidium --bin gpuidium
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN="${RUSTUP_TOOLCHAIN:-stable}"
  export CARGO_TARGET_DIR=target
  # Unit tests of the GUI-free core; the browser-engine tests need a display.
  cargo test --frozen -p gpuidium-core
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/gpuidium "$pkgdir/usr/bin/gpuidium"
  install -Dm644 packaging/io.github.rpietzsch.GPUIdium.desktop \
    "$pkgdir/usr/share/applications/io.github.rpietzsch.GPUIdium.desktop"
  install -Dm644 packaging/io.github.rpietzsch.GPUIdium.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.rpietzsch.GPUIdium.metainfo.xml"
  install -Dm644 packaging/icons/io.github.rpietzsch.GPUIdium.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.rpietzsch.GPUIdium.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
